# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to Git!

# ─── Algorand Network ───
# No private keys on the server!  All signing happens in Pera Wallet.
ALGO_NETWORK=testnet
ALGOD_ADDRESS=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_ADDRESS=https://testnet-idx.algonode.cloud
INDEXER_TOKEN=

# Certificate Store App ID (deployed via AlgoKit)
CERT_APP_ID=755556381

# CampusCoin Stablecoin ASA ID (set after deploying via /api/prepare_campus_coin_deploy)
# CAMPUS_COIN_ID=

# (Optional) Deployer mnemonic — used ONLY by contracts/deploy.py CLI
# DEPLOYER_MNEMONIC="your 25 word mnemonic here"

# ─── Flask Configuration ───
FLASK_SECRET_KEY=your-secret-key-here
FLASK_ENV=development
# Set FLASK_DEBUG=true only during local development, never in production
FLASK_DEBUG=false

# ─── Database ───
DATABASE_PATH=database/campus.db

# ─── Gemini AI Chatbot ───
GEMINI_API_KEY=your-gemini-api-key-here
# ALGOD_TOKEN=
